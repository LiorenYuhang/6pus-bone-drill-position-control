<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pus6_bringup</name>
  <version>0.1.0</version>
  <description>Bringup and orchestration package for 6PUS robot platform.</description>
  <maintainer email="dev@example.com">bone_drill</maintainer>
  <license>MIT</license>

  <depend>rclpy</depend>
  <depend>launch</depend>
  <depend>launch_ros</depend>
  <depend>h30_imu</depend>
  <depend>pus6_motor_driver</depend>
  <depend>pus6_kinematics</depend>
  <depend>pus6_control</depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
